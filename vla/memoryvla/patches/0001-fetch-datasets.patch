diff --git a/vla/datasets/rlds/oxe/transforms.py b/vla/datasets/rlds/oxe/transforms.py
index 3fad662..ae595d5 100644
--- a/vla/datasets/rlds/oxe/transforms.py
+++ b/vla/datasets/rlds/oxe/transforms.py
@@ -846,6 +846,27 @@ def mikasa_dataset_transform(trajectory: Dict[str, Any]) -> Dict[str, Any]:
     return trajectory
 
 
+# Fetch (MIKASA-Robo-MMM): the recorded 13D action holds absolute targets for the arm (0-6), head
+# (8, 9) and torso (10); they become deltas from the same frame's joints, which the 12D state
+# holds at these indices (mikasa_pi05.transforms.STATE_TO_ACTION_ORDER). At inference the measured
+# joints are added back. The gripper (7) and the base velocities (11, 12) stay as recorded.
+FETCH_ARM_STATE = [2, 4, 5, 6, 7, 8, 9]
+FETCH_HEAD_STATE = [1, 3]
+FETCH_TORSO_STATE = [0]
+
+
+def fetch_dataset_transform(trajectory: Dict[str, Any]) -> Dict[str, Any]:
+    a, s = trajectory["action"], tf.cast(trajectory["observation"]["state"], trajectory["action"].dtype)
+    trajectory["action"] = tf.concat([
+        a[:, :7] - tf.gather(s, FETCH_ARM_STATE, axis=-1),
+        a[:, 7:8],
+        a[:, 8:10] - tf.gather(s, FETCH_HEAD_STATE, axis=-1),
+        a[:, 10:11] - tf.gather(s, FETCH_TORSO_STATE, axis=-1),
+        a[:, 11:13],
+    ], axis=-1)
+    return trajectory
+
+
 # === Registry ===
 OXE_STANDARDIZATION_TRANSFORMS = {
     "bridge_oxe": bridge_oxe_dataset_transform,
@@ -931,4 +952,10 @@ OXE_STANDARDIZATION_TRANSFORMS = {
 
     ### mikasa datasets
     "mikasa_dataset": mikasa_dataset_transform,
+    "fetch_samedrawer": fetch_dataset_transform,
+    "fetch_seasondish": fetch_dataset_transform,
+    "fetch_cabinetsearch": fetch_dataset_transform,
+    "fetch_depthrecall": fetch_dataset_transform,
+    "fetch_takeitback": fetch_dataset_transform,
+    "fetch_veggie": fetch_dataset_transform,
 }
